prefix : <http://example.org/> 
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>

:a rdf:type :Person   ;
   :name    "Alice"   ;
   :age     30        ;
   :knows   :b        .
:b rdf:type :Person   ;
   :name    "Bob"  ;
   :knows   :a        .
:c rdf:type :Person   ;
   :name    23        .
